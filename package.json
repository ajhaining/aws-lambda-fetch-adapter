{
  "name": "aws-lambda-fetch-adapter",
  "version": "1.0.2",
  "description": "Fetch API adapters for API Gateway and Lambda Function URLs",
  "keywords": [
    "api-gateway",
    "aws",
    "fetch",
    "function-url",
    "lambda"
  ],
  "homepage": "https://github.com/ajhaining/aws-lambda-fetch-adapter#readme",
  "bugs": {
    "url": "https://github.com/ajhaining/aws-lambda-fetch-adapter/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajhaining/aws-lambda-fetch-adapter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./api-gateway-v1": "./dist/api-gateway-v1.mjs",
    "./api-gateway-v2": "./dist/api-gateway-v2.mjs",
    "./function-url": "./dist/function-url.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check:package",
    "check:package": "publint --strict",
    "dev": "tsdown --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@types/aws-lambda": "^8.10.163"
  },
  "peerDependenciesMeta": {
    "@types/aws-lambda": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "24.21.0",
    "npm": "12.0.2"
  }
}
